/* HamRig native desktop adaptation. Shared token values live in theme.py.
 * Colour, type, cards, buttons and state semantics follow Gateway 3 / amps.
 * Alpha channels below use Qt's 0..255 convention, not CSS's 0..1.
 */
QWidget { background: $hamrig_dark; color: $hamrig_light; font-family: $font_primary; font-size: 13px; }
QMainWindow, QScrollArea, QScrollArea > QWidget > QWidget { background: $hamrig_dark; }
QLabel { background: transparent; }
QFrame#card { background: $hamrig_dark_3; border: 1px solid $hamrig_border; border-radius: 14px; }
QFrame#card[tone="tx"] { border-color: rgba(255, 59, 48, 166); }
QFrame#card[tone="bad"] { border-color: $hamrig_danger; }
QLabel#brand { font-size: 27px; font-weight: 700; letter-spacing: -1px; }
QLabel#eyebrow { color: $hamrig_light_2; font-size: 11px; font-weight: 600; letter-spacing: 0.5px; }
QLabel#muted { color: $hamrig_light_2; }
QLabel#footer { color: $hamrig_light_muted; font-size: 11px; }
QLabel#frequency { font-size: 36px; font-weight: 600; font-family: $font_mono; }
QLabel#power { font-size: 52px; font-weight: 600; font-family: $font_mono; color: $hamrig_light; }
QLabel#sectionTitle { font-size: 23px; font-weight: 600; }
QLabel#meterValue { font-size: 23px; font-weight: 600; font-family: $font_mono; }
QLabel#mode { font-family: $font_mono; font-weight: 700; font-size: 15px; letter-spacing: 1px; }
QLabel#status { background: $surface_high; color: $hamrig_light_2; border: 1px solid $hamrig_border; padding: 7px 11px; border-radius: 12px; font-family: $font_mono; font-size: 12px; }
QLabel#status[tone="ok"] { color: $hamrig_success; border-color: rgba(52, 199, 89, 100); background: rgba(52, 199, 89, 20); }
QLabel#status[tone="warn"] { color: $amp_warn; border-color: rgba(245, 158, 11, 115); background: rgba(245, 158, 11, 20); }
QLabel#status[tone="info"] { color: $hamrig_info; border-color: rgba(10, 132, 255, 100); background: rgba(10, 132, 255, 30); }
QLabel#status[tone="tx"], QLabel#status[tone="bad"] { color: #FFFFFF; border-color: $hamrig_danger; background: $hamrig_danger; }
QLabel#mode[tone="ok"] { color: $hamrig_success; }
QLabel#mode[tone="warn"] { color: $amp_warn; }
QLabel#mode[tone="neutral"] { color: $hamrig_light_muted; }
QLabel#guard { color: $hamrig_light_2; }
QLabel#guard[tone="ok"] { color: $hamrig_success; }
QLabel#guard[tone="warn"] { color: $amp_warn; }
QLabel#guard[tone="bad"] { color: $alarm_text; }
QLabel#notice { background: $hamrig_dark_2; border: 1px solid $hamrig_border; border-radius: 10px; padding: 10px 12px; color: $hamrig_light_2; }

QPushButton { background: $surface_high; border: 1px solid rgba(255, 255, 255, 26); border-radius: 9px; padding: 7px 12px; font-weight: 600; }
QPushButton[control="true"] { font-family: $font_mono; }
QPushButton:hover { background: $hamrig_dark_4; border-color: rgba(224, 82, 82, 140); }
QPushButton:pressed { background: $hamrig_primary_dark; border-color: $hamrig_accent_tint; }
QPushButton:checked { background: rgba(139, 29, 29, 102); color: #FFFFFF; border-color: $hamrig_accent_tint; }
QPushButton[selectionTone="ok"]:checked { background: rgba(52, 199, 89, 46); color: $hamrig_success; border-color: rgba(52, 199, 89, 204); }
QPushButton[selectionTone="warn"]:checked { background: rgba(245, 158, 11, 31); color: $amp_warn; border-color: rgba(245, 158, 11, 140); }
QPushButton:disabled { background: $hamrig_dark_2; color: $hamrig_light_3; border-color: $hamrig_border_light; }
QPushButton:checked:disabled { background: rgba(139, 29, 29, 55); color: $hamrig_light_2; border-color: rgba(224, 82, 82, 100); }
QPushButton[selectionTone="ok"]:checked:disabled { background: rgba(52, 199, 89, 23); color: $hamrig_success; border-color: rgba(52, 199, 89, 100); }
QPushButton[selectionTone="warn"]:checked:disabled { background: rgba(245, 158, 11, 20); color: $amp_warn; border-color: rgba(245, 158, 11, 100); }
QPushButton#primary { background: $hamrig_accent; border-color: rgba(224, 82, 82, 128); color: #FFFFFF; }
QPushButton#primary:hover { background: #A02424; }
QPushButton#primary:pressed { background: $hamrig_primary_dark; }
QPushButton#primary:disabled { background: $hamrig_dark_2; border-color: $hamrig_border; color: $hamrig_light_3; }
QPushButton#command_power_off:hover { border-color: $hamrig_danger; }
QPushButton:focus, QPushButton#primary:focus { border-color: $hamrig_accent_tint; }

QProgressBar { background: $amp_bezel; border: 1px solid $hamrig_border_light; border-radius: 4px; min-height: 7px; max-height: 7px; }
QProgressBar::chunk { background: $hamrig_success; border-radius: 3px; }
QProgressBar::chunk:disabled { background: $hamrig_light_3; }
QLineEdit, QSpinBox, QComboBox { background: $hamrig_dark_3; color: $hamrig_light; border: 1px solid rgba(255, 255, 255, 31); border-radius: 9px; padding: 9px; selection-background-color: $hamrig_accent; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: $hamrig_accent_tint; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url("$chevron_down"); width: 14px; height: 14px; }
QSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; }
QSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; border: none; }
QSpinBox::up-arrow { image: url("$chevron_up"); width: 12px; height: 12px; }
QSpinBox::down-arrow { image: url("$chevron_down"); width: 12px; height: 12px; }
QComboBox QAbstractItemView { background: $hamrig_dark_3; color: $hamrig_light; selection-background-color: $hamrig_accent; selection-color: #FFFFFF; }
QTabWidget::pane { border: none; }
QTabBar::tab { padding: 9px 17px; margin: 0 8px 2px 0; border-radius: 10px; border: 1px solid $hamrig_border; background: $hamrig_dark_2; color: $hamrig_light_2; }
QTabBar::tab:selected { color: $hamrig_light; border-color: $hamrig_accent_tint; background: rgba(139, 29, 29, 56); }
QTabBar::tab:hover { border-color: rgba(224, 82, 82, 115); color: $hamrig_light; }
QPlainTextEdit, QTextBrowser { background: $hamrig_dark_2; border: 1px solid $hamrig_border; border-radius: 12px; padding: 12px; selection-background-color: $hamrig_accent; }
QPlainTextEdit { font-family: $font_mono; }
QToolTip { background: $surface_high; color: $hamrig_light; border: 1px solid $amp_rim; padding: 7px; }
QScrollBar:vertical { background: $hamrig_dark_2; width: 10px; }
QScrollBar::handle:vertical { background: $hamrig_dark_4; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
