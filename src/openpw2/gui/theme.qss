QWidget { background: #0d151e; color: #e8eef4; font-family: "Segoe UI", "DejaVu Sans"; font-size: 13px; }
QMainWindow, QScrollArea, QScrollArea > QWidget > QWidget { background: #0d151e; }
QFrame#card { background: #141f2a; border: 1px solid #263443; border-radius: 14px; }
QFrame#card QLabel, QFrame#card QWidget#clear { background: transparent; }
QLabel#brand { font-size: 27px; font-weight: 700; letter-spacing: -1px; }
QLabel#eyebrow { color: #8195a8; font-size: 11px; font-weight: 600; }
QLabel#muted { color: #93a7b9; }
QLabel#status { background: #162d2b; color: #6ee0bd; padding: 7px 13px; border-radius: 12px; }
QLabel#frequency { font-size: 38px; font-weight: 600; font-family: "Cascadia Mono", "Consolas", monospace; }
QLabel#power { font-size: 54px; font-weight: 600; color: #6ee0bd; }
QLabel#meterValue { font-size: 23px; font-weight: 600; }
QLabel#notice { background: #152432; border: 1px solid #294358; border-radius: 9px; padding: 10px; color: #b6cbdc; }
QLabel#footer { color: #8195a8; font-size: 11px; }
QPushButton { background: #203041; border: 1px solid #34485c; border-radius: 8px; padding: 7px 13px; font-weight: 600; }
QPushButton:hover { background: #2b4056; border-color: #65849d; }
QPushButton:pressed { background: #35516b; }
QPushButton:checked { background: #183d36; color: #7df1ca; border-color: #39876e; }
QPushButton:disabled { background: #15202b; color: #536579; border-color: #233140; }
QPushButton#primary { background: #63dab2; color: #082a20; border-color: #63dab2; }
QPushButton#primary:hover { background: #88ebca; }
QPushButton#primary:disabled { background: #203c37; border-color: #2b4b43; color: #668c81; }
QPushButton#danger { color: #f5bd9b; }
QProgressBar { background: #263746; border: none; border-radius: 3px; min-height: 6px; max-height: 6px; }
QProgressBar::chunk { background: #62d8b0; border-radius: 3px; }
QLineEdit, QSpinBox, QComboBox { background: #0d1722; border: 1px solid #35495e; border-radius: 6px; padding: 9px; selection-background-color: #317967; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #6ee0bd; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView { background: #1b2b3b; color: #e8eef4; selection-background-color: #2a6354; }
QTabWidget::pane { border: none; }
QTabBar::tab { padding: 12px 19px; background: #0d151e; color: #91a5b8; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #78e4c1; border-bottom: 2px solid #63dab2; }
QPlainTextEdit, QTextBrowser { background: #101c27; border: 1px solid #263746; border-radius: 8px; padding: 12px; }
QToolTip { background: #233649; color: #edf4fa; border: 1px solid #526e87; padding: 7px; }
QScrollBar:vertical { background: #101a25; width: 10px; }
QScrollBar::handle:vertical { background: #3a4e60; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
